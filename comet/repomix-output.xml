    print("  Std  mixing weights:", all_weights.std(axis=0).round(3))
    mean_ent = -(all_weights * np.log(all_weights + 1e-8)).sum(axis=1).mean()
    print(f"  Mean entropy: {mean_ent:.3f} / {np.log(D_ATOMS):.2f} max")

    n_rows = max(1, D_ATOMS // 2)
